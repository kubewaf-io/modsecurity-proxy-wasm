{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:makefileVersions"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/tests/**",
    "**/__fixtures__/**"
  ],
  "pinDigests": true,
  "packageRules": [
    {
      "description": "Group ModSecurity tag and commit SHA",
      "matchDepNames": ["owasp-modsecurity/ModSecurity"],
      "groupName": "modsecurity"
    },
    {
      "description": "Group PCRE2 tag and commit SHA; tags are pcre2-MAJOR.MINOR",
      "matchDepNames": ["PCRE2Project/pcre2"],
      "groupName": "pcre2",
      "extractVersion": "^pcre2-(?<version>.*)$",
      "versioning": "loose"
    },
    {
      "description": "Group libxml2 tag and commit SHA",
      "matchDepNames": ["GNOME/libxml2"],
      "groupName": "libxml2"
    },
    {
      "description": "Group proxy-wasm-cpp-sdk across Makefile, shell.nix, and versions.env",
      "matchDepNames": ["proxy-wasm/proxy-wasm-cpp-sdk"],
      "groupName": "proxy-wasm-cpp-sdk"
    },
    {
      "description": "Group Envoy image across Makefile, compose, workflows, and versions.env",
      "matchDepNames": ["envoyproxy/envoy"],
      "groupName": "envoy"
    },
    {
      "description": "Group coraza-proxy-wasm release version (zip checksum is manual)",
      "matchDepNames": ["corazawaf/coraza-proxy-wasm"],
      "groupName": "coraza-proxy-wasm",
      "pinDigests": false
    },
    {
      "description": "Pin Debian base image digests in Dockerfiles",
      "matchManagers": ["dockerfile"],
      "matchDepNames": ["debian"],
      "pinDigests": true
    },
    {
      "description": "Git commit pins use git versioning",
      "matchManagers": ["regex"],
      "matchDepNames": ["proxy-wasm/proxy-wasm-cpp-sdk"],
      "versioning": "git"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Git commit SHA digest pins in Makefile (*_VERSION + *_SHA). currentValue is required with currentDigest.",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?\\s*\\n[A-Z0-9_]+_VERSION \\?= (?<currentValue>[^\\s\\n]+)\\s*\\n# renovate: datasource=(?:[^\\s]+) depName=(?:[^\\s]+?)(?: versioning=(?:[^\\s]+))?(?: extractVersion=(?:[^\\s]+))? digest\\s*\\n[A-Z0-9_]+_SHA \\?= (?<currentDigest>[a-f0-9]{40})"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "proxy-wasm-cpp-sdk git commit in Makefile",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+))?\\s*\\nPROXY_WASM_CPP_SDK_VERSION \\?= (?<currentValue>[a-f0-9]{40})"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}git{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Docker image pins in Makefile (ENVOY_IMAGE=repo:tag → currentValue is tag only)",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+))?\\s*\\n[A-Z0-9_]+_IMAGE \\?= [^:\\s\\n]+:(?<currentValue>[^\\s\\n]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Dependency pins in build/deps/versions.env (mirror of Makefile)",
      "managerFilePatterns": [
        "/build/deps/versions\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?\\s*\\n[A-Z0-9_]+_VERSION=(?<currentValue>[^\\s\\n]+)\\s*\\n# renovate: datasource=(?:[^\\s]+) depName=(?:[^\\s]+?)(?: versioning=(?:[^\\s]+))?(?: extractVersion=(?:[^\\s]+))? digest\\s*\\n[A-Z0-9_]+_SHA=(?<currentDigest>[a-f0-9]{40})",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?\\s*\\n[A-Z0-9_]+_VERSION=(?<currentValue>[^\\s\\n]+)",
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+))?\\s*\\n[A-Z0-9_]+_IMAGE=[^:\\s\\n]+:(?<currentValue>[^\\s\\n]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "proxy-wasm-cpp-sdk git commit in shell.nix (update sha256 manually after rev bumps)",
      "managerFilePatterns": [
        "/build/shell\\.nix$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+))?\\s*\\n\\s+rev = \"(?<currentValue>[a-f0-9]{40})\";"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}git{{/if}}"
    },
    {
      "customType": "regex",
      "description": "coraza-proxy-wasm release version only (zip SHA256 is manual; github-releases digests are not asset hashes)",
      "managerFilePatterns": [
        "/test/perf/versions\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+))?\\s*\\nCORAZA_VERSION=(?<currentValue>[^\\s\\n]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Unit test tool pins in test/install-test-tools.sh",
      "managerFilePatterns": [
        "/test/install-test-tools\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s*\\nBATS_VERSION=\"\\$\\{BATS_VERSION:-(?<currentValue>v[^\"]+)\\}\"",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s*\\nGTEST_VERSION=\"\\$\\{GTEST_VERSION:-(?<currentValue>v[^\"]+)\\}\""
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Docker image tags in test compose files (currentValue is tag only, not image:tag)",
      "managerFilePatterns": [
        "/test/perf/docker-compose\\.k6\\.yml$/",
        "/test/regression/ftw/docker-compose\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>ghcr\\.io/[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s*\\n\\s+image: ghcr\\.io/[^:\\s]+:(?<currentValue>[^\\s\\n]+)",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>alpine)(?: versioning=(?<versioning>[^\\s]+?))?\\s*\\n\\s+image: alpine:(?<currentValue>[^\\s\\n]+)",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>grafana/k6)(?: versioning=(?<versioning>[^\\s]+?))?\\s*\\n\\s+image: \\$\\{K6_IMAGE:-grafana/k6:(?<currentValue>[^}]+)\\}"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Hardcoded Envoy image tag in GitHub workflow run steps",
      "managerFilePatterns": [
        "/\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "envoyproxy/envoy:(?<currentValue>v[^\\s\"']+)"
      ],
      "depNameTemplate": "envoyproxy/envoy",
      "datasourceTemplate": "docker",
      "versioningTemplate": "loose"
    }
  ]
}
