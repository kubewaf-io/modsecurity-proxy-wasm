{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:makefileVersions"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Git commit SHA pins in Makefile (*_SHA and SDK commit)",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))? digest\\s*\\n[A-Z0-9_]+_SHA \\?= (?<currentValue>[a-f0-9]{40})",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\s*\\nPROXY_WASM_CPP_SDK_VERSION \\?= (?<currentValue>[a-f0-9]{40})"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "proxy-wasm-cpp-sdk pin in shell.nix (keep in sync with Makefile)",
      "managerFilePatterns": [
        "/build/shell\\.nix$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\s*\\n\\s+rev = \"(?<currentValue>[a-f0-9]{40})\";"
      ]
    }
  ]
}